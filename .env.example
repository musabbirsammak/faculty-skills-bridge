# Copy to .env and adjust.

# --- This university ---
INSTITUTION_NAME=Your University
# Production only: the domain this installation runs on
DOMAIN=skills.example.edu

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: https://skills.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database: mysql (default) or sqlite for a quick look ---
DB_ENGINE=mysql
DB_NAME=skills_bridge
DB_USER=skills_bridge
DB_PASSWORD=skills_bridge
DB_HOST=127.0.0.1
DB_PORT=3306
# Production (docker-compose.prod.yml) only
DB_ROOT_PASSWORD=change-me

# --- Email for password resets (printed to the console if not set) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.edu
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Faculty Skills Bridge <no-reply@example.edu>

# --- Notifications: also send them by email (1) and the address used in email links ---
NOTIFY_BY_EMAIL=0
SITE_URL=http://127.0.0.1:8000

# --- Privacy: totals below this number are hidden ---
PRIVACY_MIN_GROUP=3
